#!/usr/bin/lua

local iputil = require 'gluon.iputil'
local site = require 'gluon.site'
local sysconfig = require 'gluon.sysconfig'

local uci = require('simple-uci').cursor()

--[[
	Both daemons mesh on a single address, the one the node is known by, and
	take it off the loopback interface - see gluon-olsrd-sync-interfaces.
	IPv6 has one there already; IPv4 is given one here, out of node_prefix4
	where the site has one and out of prefix4 otherwise, numbered by the MAC
	the node is identified by everywhere else so that the address is this
	node's and stays this node's.

	An address that is there already and is not the loopback one is left
	alone - an operator who set one, or an earlier run of this, meant it.
	Renumbering a node means deleting it first.
]]

local LOOPBACK4 = '127.0.0.1/8'

local function configured_address()
	for _, address in ipairs(uci:get_list('network', 'loopback', 'ipaddr')) do
		if not address:match('^127%.') then
			return address
		end
	end
end

local function generate_address()
	local prefix = site.node_prefix4()
	local range = prefix and site.node_prefix4_range()

	prefix = prefix or site.prefix4()
	if not prefix then
		return
	end

	return iputil.mac_to_ip4(prefix, uci:get('network', 'loopback', 'macaddr') or sysconfig.primary_mac, range)
end

if not configured_address() then
	local address = generate_address()

	if address then
		uci:set_list('network', 'loopback', 'ipaddr', { LOOPBACK4, address })
		uci:delete('network', 'loopback', 'netmask')
		uci:save('network')
	end
end
