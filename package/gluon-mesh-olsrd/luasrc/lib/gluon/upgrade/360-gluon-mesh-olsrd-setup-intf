#!/usr/bin/lua

local uci = require('simple-uci').cursor()
local site = require 'gluon.site'
local olsrd = require 'gluon.olsrd'
local util = require 'gluon.util'

-- one olsrd daemon per address family, enabled by the site prefix of that
-- family, each with its own jsoninfo port (see libolsrdhelper)
--
-- interfaces are added over ubus by gluon-olsrd-sync-interfaces as they come
-- and go, they inherit InterfaceDefaults; the Interface section holds the
-- runtime list

--[[
	gluon-core points mesh_uplink at br-wan itself, so the mesh and the
	uplink share one device and traffic leaks between them. Move the
	interface onto a macvlan child, which gives the mesh a device of its
	own while still riding the uplink port. Only the ifname is overridden,
	everything else gluon-core configured stays as it is.
]]
local uplink_interfaces = util.get_role_interfaces(uci, 'uplink')
for _, iface in ipairs(util.get_role_interfaces(uci, 'mesh')) do
	if util.contains(uplink_interfaces, iface) then
		uci:section('network', 'device', 'm_uplink', {
			name = 'm_uplink',
			type = 'macvlan',
			ifname = 'br-wan',
		})
		uci:section('network', 'interface', 'mesh_uplink', {
			ifname = 'm_uplink',
		})
		break
	end
end

local node_ip6 = uci:get('network', 'loopback', 'ip6addr')
-- strip the prefix length, if any
node_ip6 = node_ip6 and node_ip6:match('^[^/]+')

--[[
	olsrd only runs if the node opted in (290-gluon-mesh-olsrd-enable),
	and when gluon-mesh-babel is installed alongside it, only for IPv4:
	babel carries IPv6 in that case and the two would otherwise both
	install IPv6 routes for the same prefixes.
]]
local olsrd_enabled = uci:get_bool('gluon', 'mesh_olsrd', 'enabled')

local function file_exists(path)
	local f = io.open(path)
	if not f then
		return false
	end
	f:close()
	return true
end

local have_babel = file_exists('/etc/init.d/gluon-mesh-babel')

local daemons = {
	{
		key = 'v4',
		ipv = 4,
		prefix = site.prefix4(),
		name = 'olsrd',
		accept = '127.0.0.1',
		jsoninfo_port = 9090,
		txtinfo_port = 2006,
		-- httpinfo: IPv4 only
		httpinfo_port = 1978,
	},
	{
		key = 'v6',
		ipv = 6,
		prefix = site.prefix6(),
		name = 'olsrd6',
		accept = '::1',
		jsoninfo_port = 9091,
		txtinfo_port = 2007,
	},
}

for _, daemon in ipairs(daemons) do
	local uci_name = daemon.name
	local fw_rule = 'allow_olsr' .. daemon.ipv .. '_mesh'

	uci:delete_all(uci_name, 'Interface')
	uci:delete_all(uci_name, 'InterfaceDefaults')
	uci:delete_all(uci_name, 'LoadPlugin')

	local want = daemon.prefix and olsrd_enabled
		and not (daemon.ipv == 6 and have_babel)

	if want then
		os.execute('/etc/init.d/' .. uci_name .. ' enable')

		-- set config
		local olsrConfig = {
			FIBMetric = 'flat',
			LinkQualityLevel = '2',
			OlsrPort = 698,
			Willingness = '3',
		}

		local cfg = site.mesh.olsrd[daemon.key]
		local extraConf = cfg and cfg.config()
		if extraConf then
			for k, v in pairs(extraConf) do
				olsrConfig[k] = v
			end
		end

		-- overwrite address family set by site
		olsrConfig.IpVersion = daemon.ipv

		uci:delete_all(uci_name, 'olsrd')
		uci:section(uci_name, 'olsrd', nil, olsrConfig)

		-- add jsoninfo
		uci:section(uci_name, 'LoadPlugin', 'jsoninfo', {
			library = olsrd.find_module_version('olsrd_jsoninfo'),
			accept = daemon.accept,
			port = daemon.jsoninfo_port,
		})
		-- add txtinfo
		uci:section(uci_name, 'LoadPlugin', 'txtinfo', {
			library = olsrd.find_module_version('olsrd_txtinfo'),
			accept = daemon.accept,
			port = daemon.txtinfo_port,
		})
		-- add httpinfo
		if daemon.httpinfo_port then
			uci:section(uci_name, 'LoadPlugin', 'httpinfo', {
				library = olsrd.find_module_version('olsrd_httpinfo'),
				Net = { daemon.accept },
				port = daemon.httpinfo_port,
			})
		end

		uci:section(uci_name, 'InterfaceDefaults', nil, {
			Mode = 'mesh', -- should be mode 'ether' but that appears broken for some reason
			-- olsrd6 meshes on the node address sync-interfaces puts on every interface
			IPv6Src = daemon.ipv == 6 and node_ip6 and (node_ip6 .. '/128') or nil,
		})

		uci:section(uci_name, 'Interface', 'mesh')

		uci:foreach(uci_name, 'userconfig', function(config)
			local section_name = config['.name']

			for k, v in pairs(config) do
				if k:find("^\\.") == nil then
					if not config['.anonymous'] then
						uci:set(uci_name, section_name:sub(2), k, v)
					else
						uci:set(uci_name, uci:get_first(uci_name, 'olsrd'), k, v)
					end
				end
			end
		end)

		uci:section('firewall', 'rule', fw_rule, {
			name = 'Allow olsr' .. daemon.ipv .. ' mesh',
			src = 'mesh',
			dest_port = 698,
			proto = 'udp',
			family = 'ipv' .. daemon.ipv,
			target = 'ACCEPT',
		})
	else
		-- olsrd is off, or this family is not ours to carry. Disabling
		-- only keeps it from starting again, so stop the daemon too -
		-- otherwise turning olsr off in the web interface leaves it
		-- routing until the node is rebooted.
		os.execute('/etc/init.d/' .. uci_name .. ' stop >/dev/null 2>&1')
		os.execute('/etc/init.d/' .. uci_name .. ' disable')
	end

	uci:save(uci_name)
end

uci:save('firewall')
uci:save('network')
