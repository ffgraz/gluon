#!/usr/bin/lua

local uci = require('simple-uci').cursor()
local site = require 'gluon.site'
local util = require 'gluon.util'
local wireless = require 'gluon.wireless'
local olsrd = require 'gluon.olsrd'

local mesh_interfaces = util.get_role_interfaces(uci, 'mesh')
local uplink_interfaces = util.get_role_interfaces(uci, 'uplink')

local intf = {
	wired_mesh = {},
	vpn_mesh = {},
	radio_mesh = {},
}

-- get all mesh radios and mesh lans and then add them to olsrd
wireless.foreach_radio(uci, function(radio, _, _)
	local radio_name = radio['.name']
	if uci:get('network', 'mesh_' .. radio_name, 'proto') then
		table.insert(intf.radio_mesh, 'mesh_' .. radio_name)
	end
end)

if pcall(function() require 'gluon.mesh-vpn' end) then
	local vpn_core = require 'gluon.mesh-vpn'

	if vpn_core.enabled() then
		-- mesh_vpn is a interface that has the right ifname
		-- we can't use mesh-vpn (dash instead of underscore) since it's not a uci interface
		table.insert(intf.vpn_mesh, 'mesh_vpn')
	end
end

local has_uplink_mesh = false
local has_other_mesh = false

for _, i in pairs(mesh_interfaces) do
	if util.contains(uplink_interfaces, i) then
		has_uplink_mesh = true
	else
		has_other_mesh = true
	end
end

if has_uplink_mesh then
	-- gluon-core points mesh_uplink at br-wan itself, so the mesh and the
	-- uplink share one device and traffic leaks between them. Move the
	-- interface onto a macvlan child, which gives the mesh a device of
	-- its own while still riding the uplink port.
	uci:section('network', 'device', 'm_uplink', {
		name = 'm_uplink',
		type = 'macvlan',
		ifname = 'br-wan',
	})

	uci:section('network', 'interface', 'mesh_uplink', {
		ifname = 'm_uplink',
	})

	table.insert(intf.wired_mesh, 'mesh_uplink')
end

if has_other_mesh then
	table.insert(intf.wired_mesh, 'mesh_other')
end

--[[
	olsrd runs one daemon per address family, each one is enabled by the
	prefix of that family being set in the site configuration.

	Both daemons load jsoninfo, which gluon queries (see libolsrdhelper),
	so they need a port of their own each.
]]
--[[
	olsrd only takes an interface that carries a routable address of its
	family: get_ipv6_address() in olsrd skips loopback, link local and site
	local scopes, so an interface with nothing but its fe80 address is
	refused and never meshes.

	The node address goes on every interface the IPv6 daemon is given, the
	same one on all of them - that is what MID is for, and it keeps the
	originator stable and unique no matter which link a neighbour meets us on.
]]
local node_ip6 = uci:get('network', 'loopback', 'ip6addr')

--[[
	olsrd only runs if the node opted in (290-gluon-mesh-olsrd-enable),
	and when gluon-mesh-babel is installed alongside it, only for IPv4:
	babel carries IPv6 in that case and the two would otherwise both
	install IPv6 routes for the same prefixes.
]]
local olsrd_enabled = uci:get_bool('gluon', 'mesh_olsrd', 'enabled')

local function file_exists(path)
	local f = io.open(path)
	if not f then
		return false
	end
	f:close()
	return true
end

local have_babel = file_exists('/etc/init.d/gluon-mesh-babel')

local daemons = {
	{
		key = 'v4',
		ipv = 4,
		prefix = site.prefix4(),
		name = 'olsrd',
		accept = '127.0.0.1',
		jsoninfo_port = 9090,
		txtinfo_port = 2006,
		-- httpinfo has no known good IPv6 configuration, so it stays IPv4 only
		httpinfo_port = 1978,
	},
	{
		key = 'v6',
		ipv = 6,
		prefix = site.prefix6(),
		name = 'olsrd6',
		accept = '::1',
		jsoninfo_port = 9091,
		txtinfo_port = 2007,
	},
}

for _, daemon in ipairs(daemons) do
	local uci_name = daemon.name
	local fw_rule = 'allow_olsr' .. daemon.ipv .. '_mesh'

	uci:delete_all(uci_name, 'Interface')
	uci:delete_all(uci_name, 'LoadPlugin')

	local want = daemon.prefix and olsrd_enabled
		and not (daemon.ipv == 6 and have_babel)

	if want then
		os.execute('/etc/init.d/' .. uci_name .. ' enable')

		-- set config
		local olsrConfig = {
			FIBMetric = 'flat',
			LinkQualityLevel = '2',
			OlsrPort = 698,
			Willingness = '3',
		}

		local cfg = site.mesh.olsrd[daemon.key]
		local extraConf = cfg and cfg.config()
		if extraConf then
			for k, v in pairs(extraConf) do
				olsrConfig[k] = v
			end
		end

		-- overwrite address family set by site
		olsrConfig.IpVersion = daemon.ipv

		uci:delete_all(uci_name, 'olsrd')
		uci:section(uci_name, 'olsrd', nil, olsrConfig)

		-- add jsoninfo
		uci:section(uci_name, 'LoadPlugin', 'jsoninfo', {
			library = olsrd.find_module_version('olsrd_jsoninfo'),
			accept = daemon.accept,
			port = daemon.jsoninfo_port,
		})
		-- add txtinfo
		uci:section(uci_name, 'LoadPlugin', 'txtinfo', {
			library = olsrd.find_module_version('olsrd_txtinfo'),
			accept = daemon.accept,
			port = daemon.txtinfo_port,
		})
		-- add httpinfo
		if daemon.httpinfo_port then
			uci:section(uci_name, 'LoadPlugin', 'httpinfo', {
				library = olsrd.find_module_version('olsrd_httpinfo'),
				Net = { daemon.accept },
				port = daemon.httpinfo_port,
			})
		end

		for _, name in ipairs({ 'wired_mesh', 'vpn_mesh', 'radio_mesh' }) do
			if #intf[name] > 0 then
				uci:section(uci_name, 'Interface', name, {
					interface = intf[name],
					Mode = 'mesh', -- should be mode 'ether' but that appears broken for some reason
					-- leaves olsrd no choice but the address we put there
					IPv6Src = daemon.ipv == 6 and node_ip6 and (node_ip6 .. '/128') or nil,
				})

				if daemon.ipv == 6 and node_ip6 then
					for _, iface in ipairs(intf[name]) do
						uci:set('network', iface, 'ip6addr', node_ip6)
					end
				end
			end
		end

		uci:foreach(uci_name, 'userconfig', function(config)
			local section_name = config['.name']

			for k, v in pairs(config) do
				if k:find("^\\.") == nil then
					if not config['.anonymous'] then
						uci:set(uci_name, section_name:sub(2), k, v)
					else
						uci:set(uci_name, uci:get_first(uci_name, 'olsrd'), k, v)
					end
				end
			end
		end)

		uci:section('firewall', 'rule', fw_rule, {
			name = 'Allow olsr' .. daemon.ipv .. ' mesh',
			src = 'mesh',
			dest_port = 698,
			proto = 'udp',
			family = 'ipv' .. daemon.ipv,
			target = 'ACCEPT',
		})
	else
		-- olsrd is off, or this family is not ours to carry
		os.execute('/etc/init.d/' .. uci_name .. ' disable')
		uci:delete('firewall', fw_rule)
	end

	uci:save(uci_name)
end

uci:save('firewall')
uci:save('network')
