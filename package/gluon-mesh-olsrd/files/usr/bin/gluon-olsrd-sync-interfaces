#!/bin/sh

# Runs the olsrd daemons on exactly the mesh interfaces netifd has up.
#
# olsrd takes interfaces over ubus, this script hands them to olsr.
# If the daemon is down the interfaces are also written to the uci state,
# so if the daemon comes back on it's interfaces are the right ones.
#
# Called from the gluon_mesh protocol hooks, with the interface that is being
# torn down as its argument, if there is one, otherwise no arguments.

# shellcheck disable=SC1091
. /lib/functions.sh

GONE="$1"

DUMP="$(ubus call network.interface dump)"

device_of() {
	echo "$DUMP" | jsonfilter -e "@.interface[@.interface='$1'].device"
}

# olsr requires a routable address on all it's interfaces
# Get the address of the family that's required for the daemon
address_of() {
	local address

	case "$1" in
		olsrd6)
			uci -q get network.loopback.ip6addr
			;;
		olsrd)
			# the address on loopback that is not the loopback one, put
			# there by 350-gluon-mesh-olsrd-node-address
			for address in $(uci -q get network.loopback.ipaddr); do
				case "$address" in
					127.*) ;;
					*) echo "${address%/*}"; return ;;
				esac
			done
			;;
		*)
			exit 2
			;;
	esac
}

ifname_call() {
	ubus call "$1" "$2" "{\"ifname\":\"$3\"}" > /dev/null 2>&1

	case "$?" in
		0) ;;
		4) ;; # no such object: the daemon is not running, the state will tell it when it starts
		6) ;; # add: it has the interface already, del: it never had it
		*) logger -t gluon-mesh-olsrd "$1 $2 $3 failed" ;;
	esac
}

daemons=
for daemon in olsrd olsrd6; do
	[ -x "/etc/init.d/$daemon" ] || continue
	"/etc/init.d/$daemon" enabled || continue

	daemons="$daemons $daemon"

	[ -n "$(address_of "$daemon")" ] ||
		logger -t gluon-mesh-olsrd "$daemon has no address to mesh with, it will take no interface"
done

interfaces=

for iface in $(echo "$DUMP" | jsonfilter -e "@.interface[@.proto='gluon_mesh' && @.up=true].interface"); do
	[ "$iface" != "$GONE" ] || continue

	device="$(device_of "$iface")"
	[ -n "$device" ] || continue

	for daemon in $daemons; do
		address="$(address_of "$daemon")"
		[ -z "$address" ] || ip addr replace "$address" dev "$device"

		ifname_call "$daemon" add_interface "$device"
	done

	interfaces="$interfaces $iface"
done

device=
[ -z "$GONE" ] || device="$(device_of "$GONE")"

if [ -n "$device" ]; then
	for daemon in $daemons; do
		ifname_call "$daemon" del_interface "$device"

		address="$(address_of "$daemon")"
		# the device is usually on its way out with the interface
		[ -z "$address" ] || ip addr del "$address" dev "$device" 2>/dev/null
	done
fi

# what the init script builds olsrd.conf from the next time a daemon starts
for daemon in $daemons; do
	uci_toggle_state "$daemon" mesh interface "${interfaces# }"
done
