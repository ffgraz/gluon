#!/bin/sh /etc/rc.common
USE_PROCD=1
START=45
PORT=33123

DAEMON=/usr/sbin/babeld
pidfile=/var/run/gluon-babeld.pid
nodeipfile=/var/run/gluon-babeld.nodeip
CONFIGFILE=/etc/gluon-babeld.conf
BABELOPTSFILE=/tmp/addn-babelopts
touch $BABELOPTSFILE

start_service() {
	# The node address is generated at boot when the site asks for a
	# temporary one, which is after the configuration was written, so
	# the source address to install routes with is taken here rather
	# than baked into the config file. babeld installs nothing at all
	# when told to use an address the node does not have.
	local nodeip
	nodeip="$(uci -q get network.loopback.ip6addr | cut -d/ -f1)"
	echo "$nodeip" > $nodeipfile

	procd_open_instance
	procd_set_param command $DAEMON
	procd_append_param command -D -I "$pidfile" -G "$PORT" -c "$CONFIGFILE" $(cat $BABELOPTSFILE)
	# Options have to come before the interface argument: babeld takes
	# everything after the first non-option as an interface name.
	[ -n "$nodeip" ] && procd_append_param command -C "install pref-src $nodeip"
	procd_append_param command babeldummydoesnotexist
	procd_set_param respawn ${respawn_threshold:-60} ${respawn_timeout:-5} ${respawn_retry:-0}
	procd_set_param stderr 1
	procd_set_param stdout 1
	procd_close_instance
}

echotobabel() {
	local count=0
	local line="$1"
	local maxretries=10
	while ! (echo -e "$line" | busybox nc ::1 "$PORT" >/dev/null 2>&1)
	do
		sleep 1
		echo retrying to connect to babeld in PID $$, waited ${count}s >&2
		count=$((count+1))
		if [ $count -gt $maxretries ]; then
			return 1
		fi
	done
	return 0
}

waitforsocket() {
	echotobabel "dump"
	[ $? -gt 0 ] && { echo "Failed to connect to babeld socket on port $PORT, assuming the service was not started properly"; exit 43; }
}

mesh_devices() {
	gluon-list-mesh-interfaces
}

reload_service() {
	# The source address is only read at start time, and babeld keeps
	# installing routes with an address the node no longer has once it is
	# renumbered - so a changed node address needs a restart, not a reload.
	if [ "$(uci -q get network.loopback.ip6addr | cut -d/ -f1)" != "$(cat $nodeipfile 2>/dev/null)" ]; then
		restart
		return
	fi

	waitforsocket

	for i in $(mesh_devices)
	do
	if ! echotobabel dump|grep "add interface"|grep -q $i
	then
		echotobabel "interface $i update-interval 300"
	fi
	done

	for i in $(echotobabel "dump"|grep "add interface"|cut -d" " -f3)
	do
		if ! mesh_devices|grep -q $i
		then
			echotobabel "flush interface $i"
		fi
	done
}

service_triggers() {
	local script=$(readlink "$initscript")
	local name=$(basename "${script:-$initscript}")

	procd_open_trigger
	procd_add_raw_trigger "interface.*" 0 "/etc/init.d/$name" reload
	procd_close_trigger
}

service_started() {
# make sure the init script does not finish until babeld is actually up.
# unfortunately procd will still start multiple instances of the same script which is why waitforsocket is also run on reload
	waitforsocket
	# babeld is started with a dummy interface only, the real ones are handed
	# to it over the socket - without this a restart leaves it meshing on
	# nothing until some unrelated netifd event happens to fire the trigger
	reload_service
}
stop_service(){
	kill $(pgrep -P 1 babeld)
}
status() {
	kill -USR1 $(pgrep -P 1 babeld)
}
