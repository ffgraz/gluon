From efe25cae1770465b35f720d0339a9723094512a7 Mon Sep 17 00:00:00 2001
From: Martin Schiller <ms@dev.tdt.de>
Date: Sun, 13 Sep 2026 20:37:10 +0200
Subject: [PATCH 2/2] openvpn: add missing options

Add missing options taken from the OpenVPN 2.6 manual.

Backport of 390cdc14197c45d0dba08bfc519c0d075390449f, which never
reached openwrt-25.12. Without it the uci translation drops every
option in the list - mark among them, silently.

Signed-off-by: Martin Schiller <ms@dev.tdt.de>
---
 net/openvpn/Makefile              |  2 +-
 net/openvpn/files/openvpn.options | 56 +++++++++++++++++++++++++++++++
 2 files changed, 57 insertions(+), 1 deletion(-)

diff --git a/net/openvpn/Makefile b/net/openvpn/Makefile
index a650c4702..b97b2eef3 100644
--- a/net/openvpn/Makefile
+++ b/net/openvpn/Makefile
@@ -10,7 +10,7 @@ include $(TOPDIR)/rules.mk
 PKG_NAME:=openvpn
 
 PKG_VERSION:=2.7.6
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 
 PKG_SOURCE_URL:=\
 	https://build.openvpn.net/downloads/releases/ \
diff --git a/net/openvpn/files/openvpn.options b/net/openvpn/files/openvpn.options
index 5ccc33236..c7e027e9d 100644
--- a/net/openvpn/files/openvpn.options
+++ b/net/openvpn/files/openvpn.options
